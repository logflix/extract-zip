{
  "name": "@logflix/extract-zip",
  "version": "2.0.2",
  "description": "unzip a zip file into a directory using 100% javascript",
  "keywords": [
    "extract",
    "unzip",
    "zip"
  ],
  "license": "BSD-2-Clause",
  "author": "max ogden",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logflix/extract-zip.git"
  },
  "bin": {
    "extract-zip": "cli.js"
  },
  "files": [
    "cli.js",
    "index.d.ts"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "ava": "ava",
    "coverage": "nyc --reporter=lcov --reporter=text ava",
    "format": "oxfmt",
    "lint": "tsd && oxlint",
    "test": "ava"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "get-stream": "^9.0.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "ava": "^8.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nyc": "^18.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsd": "^0.33.0",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@types/yauzl": "^3.4.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": "node --run format && node --run lint"
  },
  "engines": {
    "node": ">= 10.17.0"
  },
  "packageManager": "npm@12.0.2+sha512.b885e890b9418fa1693544d05f53e64f9a73ec194837d4258b15fecdd692347b1dd2a517b1b0cbaf9d31cd8e92c3b70956bd2ecc72833a57b4b3098f5bfa7943"
}
