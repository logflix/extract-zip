{
  "name": "@logflix/extract-zip",
  "version": "2.0.2",
  "description": "unzip a zip file into a directory using 100% javascript",
  "keywords": [
    "extract",
    "unzip",
    "zip"
  ],
  "license": "BSD-2-Clause",
  "author": "max ogden",
  "repository": "maxogden/extract-zip",
  "bin": "cli.js",
  "files": [
    "cli.js",
    "index.d.ts"
  ],
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "ava": "ava",
    "coverage": "nyc --reporter=lcov --reporter=text ava",
    "format": "oxfmt",
    "lint": "tsd && oxlint",
    "test": "ava"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "get-stream": "^9.0.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "ava": "^8.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nyc": "^18.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsd": "^0.33.0",
    "typescript": "^6.0.3"
  },
  "optionalDependencies": {
    "@types/yauzl": "^3.4.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": "node --run format && node --run lint"
  },
  "engines": {
    "node": ">= 10.17.0"
  }
}
